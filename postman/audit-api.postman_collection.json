    "key" : "accessToken",
    "value" : "",
    "type" : "string"
  }, {
    "key" : "actor",
    "value" : "",
    "type" : "string",
    "description" : "Filter by the exact actor name (e.g., 'admin' or 'service.WORKSPACE')."
  }, {
    "key" : "action",
    "value" : "",
    "type" : "string"
  }, {
    "key" : "resourceType",
    "value" : "",
    "type" : "string"
  }, {
    "key" : "resourceId",
    "value" : "",
    "type" : "string",
    "description" : "Filter by a specific resource UUID."
  }, {
    "key" : "outcome",
    "value" : "",
    "type" : "string"
  }, {
    "key" : "startDate",
    "value" : "",
    "type" : "string",
    "description" : "ISO-8601 timestamp (e.g., 2026-09-01T00:00:00Z)."
  }, {
    "key" : "endDate",
    "value" : "",
    "type" : "string"
  }, {
    "key" : "page",
    "value" : "",
    "type" : "string"
  }, {
    "key" : "size",
    "value" : "",
    "type" : "string"
