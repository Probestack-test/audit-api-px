        "raw" : "{{baseUrl}}/audit/events/search?actor={{actor}}&action={{action}}&resourceType={{resourceType}}&resourceId={{resourceId}}&outcome={{outcome}}&startDate={{startDate}}&endDate={{endDate}}&page={{page}}&size={{size}}",
        "host" : [ "{{baseUrl}}" ],
        "path" : [ "audit", "events", "search" ],
        "query" : [ {
