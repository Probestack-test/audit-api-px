    "name" : "Ingest a new audit event (Internal Service Call)",
    "request" : {
      "method" : "POST",
      "description" : "Ingest a new audit event (Internal Service Call)\n\nResponses:\n- 201: Event successfully persisted to the immutable audit log.\n- 400: Invalid query parameters or missing required fields.\n- 500: Storage engine failure or search cluster unavailability.",
      "header" : [ {
        "key" : "Content-Type",
        "value" : "application/json",
        "type" : "text"
      } ],
      "body" : {
        "mode" : "raw",
        "raw" : "{}",
        "options" : {
          "raw" : {
            "language" : "json"
          }
        }
      },
      "url" : {
        "raw" : "{{baseUrl}}/audit/events",
        "host" : [ "{{baseUrl}}" ],
        "path" : [ "audit", "events" ]
      }
    },
    "response" : [ ]
